{
  "name": "paroquia-santo-antonio-web",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "predev": "node scripts/generate-seo-files.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-seo-files.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "npx @biomejs/biome check src/",
    "format": "npx @biomejs/biome check --write src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest --coverage.enabled=false",
    "prepare": "husky && npx chakra typegen src/styles/system.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "i18next": "^25.10.10",
    "next": "15.5.9",
    "next-i18next": "^15.4.3",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.1.9",
    "react-icons": "^5.7.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@chakra-ui/cli": "^3.37.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "core-js": false
  }
}
